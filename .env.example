# =============================================================================
# Polystream configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# The ".env" file is gitignored and must NEVER be committed or shared.
# =============================================================================

# --- Nextcloud / WebDAV source ------------------------------------------------
# Base WebDAV URL for your Nextcloud account. Format:
#   https://YOUR-NEXTCLOUD-DOMAIN/remote.php/dav/files/YOUR-USERNAME/
# Find the exact value in Nextcloud: Files -> Settings (gear, bottom-left) -> WebDAV.
# Keep the trailing slash.
WEBDAV_URL="https://cloud.example.com/remote.php/dav/files/yourusername/"

# Your Nextcloud username.
WEBDAV_USERNAME="yourusername"

# IMPORTANT: use a Nextcloud APP PASSWORD, not your real login password.
# Create it in Nextcloud: Settings -> Security -> "Create new app password".
# It can be revoked anytime and works with 2FA enabled.
WEBDAV_APP_PASSWORD=""

# Path (relative to WEBDAV_URL) to the folder that contains your library,
# i.e. the folder holding "movies" and "tv shows". Use "" if they sit at the root
# of your account. Example: "Media"
WEBDAV_MEDIA_ROOT=""

# --- App authentication -------------------------------------------------------
# The single shared password all viewers type to enter the app.
APP_SHARED_PASSWORD=""

# Secret used to sign session cookies. Use a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=""

# --- TMDB (metadata & artwork) ------------------------------------------------
# Free API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# --- Server / deployment ------------------------------------------------------
# Public URL the app is served from (nginx terminates TLS in front). e.g. https://stream.example.com
PUBLIC_APP_URL="https://stream.example.com"

# Internal port the SvelteKit Node server listens on (Caddy proxies to this).
PORT="3000"

# --- Transcoding (safe defaults for a weak VPS) -------------------------------
# Max simultaneous server-side transcode jobs. Keep at 1 on a small VPS.
MAX_TRANSCODE_JOBS="1"

# Directory for the SQLite DB file + on-disk caches. Defaults to "./data" for local
# dev; the Docker image sets this to "/data" (a mounted volume) via docker-compose.yml.
# DATA_DIR="./data"
